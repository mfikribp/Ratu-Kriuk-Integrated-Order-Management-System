{
  "compilerOptions": {
    "target": "next 18",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "node",
    "nodeModuleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["$LOOKUP_PATH($/.*)"],
    },
    "outDir": "./dist",
    "rootDir": "./app"
  },
  "include": ["app/**/*.{ts,tsx}", "app/lib/**/*.{ts,tsx}"],
  "exclude": ["node_modules"]
}